<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Matriks</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; background: #f4f4f9; }
        .container { max-width: 600px; margin: auto; background: white; padding: 20px; border-radius: 8px; }
        textarea { width: 100%; height: 80px; margin-bottom: 10px; }
        button { padding: 10px 15px; margin-right: 5px; cursor: pointer; }
        pre { background: #eee; padding: 10px; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Kalkulator Transpose Matriks</h2>
        <p>Masukkan matriks (pisahkan angka dengan koma, baris dengan enter):</p>
        <textarea id="matrixInput" placeholder="1, 2, 3&#10;4, 5, 6">1, 2, 3&#10;4, 5, 6</textarea><br>
        <button onclick="hitungTranspose()">Transpose</button>
        
        <h3>Hasil:</h3>
        <pre id="output">-</pre>
    </div>

    <script>
        function hitungTranspose() {
            let input = document.getElementById("matrixInput").value.trim();
            let rows = input.split("\n").map(r => r.split(",").map(Number));
            
            let transpose = rows[0].map((_, colIndex) => rows.map(row => row[colIndex]));
            
            document.getElementById("output").innerText = transpose.map(r => r.join(" \t ")).join("\n");
        }
    </script>
</body>
</html>
